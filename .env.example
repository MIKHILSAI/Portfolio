# Backend contact server configuration
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password-or-app-password
EMAIL_RECIPIENT=your-email@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
CLIENT_ORIGIN=http://localhost:3000

# If you want the frontend to point to the express backend directly in development:
NEXT_PUBLIC_CONTACT_API_URL=http://localhost:4000/api/contact

# Optional MongoDB persistence
# Use a valid MongoDB connection string only if you want to save messages to the database.
# Examples:
# MONGODB_URI=mongodb+srv://username:password@cluster0.rsnyexi.mongodb.net/myDatabase?retryWrites=true&w=majority
# MONGODB_URI=mongodb://username:password@localhost:27017/myDatabase
MONGODB_URI=

# Notes:
# - Copy this file to .env in the project root before running the server.
# - For Gmail, use an App Password when 2-step verification is enabled.
# - Do not commit your .env file to source control.
